:root {
    --dpad-container-height: auto;
    --action-button-container-height: auto;
}

/* Dpad */
.dpad-container {
    flex: 1;
    display: flex;
    justify-content: center;
    position: absolute;
    --dpad-container-height: inherit;
    padding: 1em;
    /* border: 1px solid white; */
}

.dpad {
    display: grid;
    grid-template-rows: 50px 50px 50px;
    grid-template-columns: 50px 50px 50px;
    gap: 2px;
    width: 152px;
    height: 152px;
}

.dpad-middle {
    display: grid;
    grid-template-columns: 50px 50px 50px;
    grid-column: 1 / 4;
    gap: 2px;
}

.dpad-btn {
    background: linear-gradient(145deg, #333333, #1a1a1a);
    border: 2px solid #444444;
    color: rgba(255, 255, 255, 0.87);
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.1s;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    user-select: none;
}

.dpad-up {
    grid-column: 2;
    border-radius: 8px 8px 0 0;
}

.dpad-down {
    grid-column: 2;
    border-radius: 0 0 8px 8px;
}

.dpad-left {
    border-radius: 8px 0 0 8px;
}

.dpad-right {
    border-radius: 0 8px 8px 0;
}

.dpad-center {
    background-color: #0a0a0a;
    border: 2px solid #444444;
}

.dpad-btn:active:not(:disabled) {
    background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
    transform: translateY(2px);
}

.dpad-btn:hover:not(:disabled) {
    border-color: #0ec3c9;
    color: #0ec3c9;
}

.dpad-btn:disabled {
    cursor: not-allowed;
    opacity: 0.3;
}

/* action buttons */
.action-buttons {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1em;
    padding: 1em;
    height: calc(var(--canvas-height) / 3);
    /* max-width: calc(var(--canvas-height) / 3); */
    /* transform: rotate(-30deg); */
    position: absolute;
    /* border: 1px solid white; */
    box-sizing: border-box;
}

.action-btn {
    width: 3em;
    height: 3em;
    border-radius: 50%;
    border: 3px solid #444444;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.1s;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
    user-select: none;
}

.a-button {
    background: linear-gradient(145deg, #d32f2f, #b71c1c);
    color: white;
    margin-top: 30px;
}

.b-button {
    background: linear-gradient(145deg, #ffa726, #f57c00);
    color: white;
}

.action-btn:active {
    box-shadow: inset 0 4px 8px rgba(0, 0, 0, 0.5);
    transform: translateY(3px);
}

.action-btn:hover {
    filter: brightness(1.2);
}

/* Mobile */
@media (max-width: 1024px) {
    /* portrait mode */
    @media (orientation: portrait) {
        .dpad-container {
            left: 4%;
            bottom: 20%;
        }

        .action-buttons {
            right: 4%;
            bottom: 20%;
        }
    }

    /* landscape mode */
    @media (orientation: landscape) {
        .dpad-container {
            left: 0;
            top: calc(var(--screen-height) / 4);
        }

        .action-buttons {
            right: 0;
            top: calc(var(--screen-height) / 4);
        }
    }
}

/* tablet */
@media (min-width: 1024px) and (max-width: 1400px) {
    /* portrait mode */
    @media (orientation: portrait) {
        .dpad-container {
            left: 4%;
            bottom: calc(var(--screen-height) * 0.1);
        }

        .action-buttons {
            right: 4%;
            bottom: calc(var(--screen-height) * 0.1);
        }
    }

    /* landscape mode */
    @media (orientation: landscape) {
        .dpad-container {
            left: 0;
            top: calc(var(--screen-height) * 0.4);
        }

        .action-buttons {
            right: 0;
            top: calc(var(--screen-height) * 0.3);
        }
    }
}

@media (min-width: 1400px) {
    .dpad-container {
        display: none;
    }

    .action-buttons {
        display: none;
    }
}
